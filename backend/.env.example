# HangukStep Backend Environment Variables
# Copy this file to .env and fill in the required values
# IMPORTANT: Never commit the .env file to version control

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/hangukstep
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here

# JWT Configuration
# Generate a strong secret key (minimum 256 bits)
# You can generate one at: https://generate-random.org/encryption-key-generator
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# JWT Token Expiration (in milliseconds)
# 604800000 = 7 days
# 86400000 = 1 day
# 3600000 = 1 hour
JWT_EXPIRATION=604800000

# Server Configuration
SERVER_PORT=8080

# CORS Configuration
# Comma-separated list of allowed origins
# For Vue frontend: http://localhost:5173
# For React frontend: http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Development Notes:
# - For local development, you can use any DB_PASSWORD
# - In production, use strong, unique passwords
# - Generate a new JWT_SECRET for production
# - Restrict CORS_ORIGINS to your actual frontend domain
