{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gradlew-build",
      "type": "shell",
      "command": "./gradlew",
      "args": [
        "build",
        "-x",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.11"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$gradle"
      ]
    },
    {
      "label": "gradlew-bootRun",
      "type": "shell",
      "command": "./gradlew",
      "args": [
        "bootRun"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.11"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "gradlew-test",
      "type": "shell",
      "command": "./gradlew",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.11"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$gradle"
      ]
    },
    {
      "label": "gradlew-clean",
      "type": "shell",
      "command": "./gradlew",
      "args": [
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21.0.11"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "init-db",
      "type": "shell",
      "command": "./scripts/init-db.sh",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
