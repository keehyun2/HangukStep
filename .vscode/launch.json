{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Spring Boot: HangukStepApplication",
      "request": "launch",
      "mainClass": "com.hangukstep.HangukStepApplication",
      "args": "",
      "vmArgs": "-Dfile.encoding=UTF-8",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": {
        "SPRING_PROFILES_ACTIVE": "local"
      },
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "cwd": "${workspaceFolder}/backend",
      "stopOnEntry": false
    },
    {
      "type": "java",
      "name": "Spring Boot: HangukStepApplication (Debug)",
      "request": "launch",
      "mainClass": "com.hangukstep.HangukStepApplication",
      "vmArgs": "-Dfile.encoding=UTF-8 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005",
      "envFile": "${workspaceFolder}/backend/.env",
      "env": {
        "SPRING_PROFILES_ACTIVE": "local"
      },
      "console": "internalConsole",
      "cwd": "${workspaceFolder}/backend",
      "stopOnEntry": true
    },
    {
      "name": "Vue: Dev Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/node_modules/vite/bin/vite.js",
      "args": [],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Vue: Build",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/node_modules/vite/bin/vite.js",
      "args": ["build"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Vue: Preview Build",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/node_modules/vite/bin/vite.js",
      "args": ["preview"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Full Stack: Backend + Frontend",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/node_modules/vite/bin/vite.js",
      "args": [],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "dependsOn": ["Spring Boot: HangukStepApplication"]
    }
  ]
}
